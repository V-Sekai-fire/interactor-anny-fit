// Phenotype → shape, data-parallel stages.  Matches viz_native/soma_pheno.c.

[[vk::binding(0, 0)]] StructuredBuffer<float3> vanny;  // (P)     Anny verts
[[vk::binding(1, 0)]] StructuredBuffer<float3> p3;     // (NFS)   fabricated tips
[[vk::binding(2, 0)]] StructuredBuffer<uint>   Ftet;   // (NFS*4) tet indices into [vanny|p3]
[[vk::binding(3, 0)]] StructuredBuffer<uint>   fids;   // (V)     source face per vertex
[[vk::binding(4, 0)]] StructuredBuffer<float>  bary;   // (V*4)   barycentric weights
[[vk::binding(5, 0)]] RWStructuredBuffer<float3> v0;   // (V)     output (SOMA frame)

[shader("compute")]
[numthreads(64, 1, 1)]
void bary_gather(uint3 tid : SV_DispatchThreadID)
{
    uint v = tid.x;
    uint V, s; v0.GetDimensions(V, s);
    if (v >= V) return;
    uint P, s2; vanny.GetDimensions(P, s2);
    uint f = fids[v];
    float3 r = float3(0.0);
    for (uint k = 0; k < 4; ++k)
    {
        uint idx = Ftet[f * 4 + k];
        float3 pt = (idx < P) ? vanny[idx] : p3[idx - P];
        r += bary[v * 4 + k] * pt;
    }
    v0[v] = float3(r.x, r.z, -r.y);
}
