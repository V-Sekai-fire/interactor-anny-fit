// Phenotype → shape, data-parallel stages.  Matches viz_native/soma_pheno.c.

[[vk::binding(0, 0)]] StructuredBuffer<float3> templ;   // (P)    template verts
[[vk::binding(1, 0)]] StructuredBuffer<float3> blend;   // (NB*P) blendshapes, row c*P+p
[[vk::binding(2, 0)]] StructuredBuffer<float>  coeffs;  // (NB)   phenotype coeffs
[[vk::binding(3, 0)]] RWStructuredBuffer<float3> vanny; // (P)    output

[shader("compute")]
[numthreads(64, 1, 1)]
void blendshape(uint3 tid : SV_DispatchThreadID)
{
