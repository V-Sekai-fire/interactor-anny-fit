        float bpx = bw[i*16+3], bpy = bw[i*16+7], bpz = bw[i*16+11];
        float3 jpi = float3(jpos[i*3], jpos[i*3+1], jpos[i*3+2]);
        float Hs[9]; for (int k = 0; k < 9; k++) Hs[k] = 0;
