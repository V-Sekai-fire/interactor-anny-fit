static const float EPS = 1e-8;

float3 cr(float3 a, float3 b) { return float3(a.y*b.z-a.z*b.y, a.z*b.x-a.x*b.z, a.x*b.y-a.y*b.x); }
float det9(float m[9]) { return m[0]*(m[4]*m[8]-m[5]*m[7]) - m[1]*(m[3]*m[8]-m[5]*m[6]) + m[2]*(m[3]*m[7]-m[4]*m[6]); }
void mul9(float A[9], float B[9], out float C[9]) {
    for (int r = 0; r < 3; r++) for (int c = 0; c < 3; c++)
        C[r*3+c] = A[r*3]*B[c] + A[r*3+1]*B[3+c] + A[r*3+2]*B[6+c];
}
void rodrigues(float3 a, float3 b, out float R[9]) {
    float an = length(a), bn = length(b);
    float3 au = a/max(an,EPS), bu = b/max(bn,EPS);
    float d = clamp(dot(au,bu), -1.0, 1.0);
    if (d < -1.0 + 1e-6) {
        float3 w = (abs(bu.x) > 0.6) ? float3(0,1,0) : float3(1,0,0);
        float3 x = cr(bu,w); x = x/length(x); float aa[3] = {x.x,x.y,x.z};
        for (int r = 0; r < 3; r++) for (int c = 0; c < 3; c++) R[r*3+c] = 2.0*aa[r]*aa[c] - ((r==c)?1.0:0.0);
        return;
    }
    float3 v = cr(bu,au);
    float K[9]; K[0]=0; K[1]=-v.z; K[2]=v.y; K[3]=v.z; K[4]=0; K[5]=-v.x; K[6]=-v.y; K[7]=v.x; K[8]=0;
    float KK[9]; mul9(K,K,KK); float f = 1.0/(1.0+d);
    for (int i = 0; i < 9; i++) R[i] = ((i%4==0)?1.0:0.0) + K[i] + f*KK[i];
}
void ns30(float H[9], out float R[9]) {
    float mrs = 0;
    for (int r = 0; r < 3; r++) { float s = abs(H[r*3])+abs(H[r*3+1])+abs(H[r*3+2]); mrs = max(mrs,s); }
    for (int i = 0; i < 9; i++) R[i] = H[i]/(mrs+EPS);
    for (int it = 0; it < 30; it++) {
        float RtR[9];
        for (int a = 0; a < 3; a++) for (int b = 0; b < 3; b++) RtR[a*3+b] = R[a]*R[b]+R[3+a]*R[3+b]+R[6+a]*R[6+b];
        float term[9]; for (int k = 0; k < 9; k++) term[k] = ((k%4==0)?3.0:0.0) - RtR[k];
        float Rn[9]; mul9(R,term,Rn); for (int k = 0; k < 9; k++) R[k] = Rn[k]*0.5;
    }
    if (det9(R) < 0) { R[2]=-R[2]; R[5]=-R[5]; R[8]=-R[8]; }
}
void regularize(inout float H[9]) {
    float scale = 0;
    for (int r = 0; r < 3; r++) { float s = abs(H[r*3])+abs(H[r*3+1])+abs(H[r*3+2]); scale = max(scale,s); }
    if (scale < EPS) scale = EPS;
    float vol = abs(det9(H))/(scale*scale*scale);
    float rw = clamp((1e-6 - vol)/1e-6, 0.0, 1.0); float add = 0.05*rw*scale;
    H[0]+=add; H[4]+=add; H[8]+=add;
}
bool valid9(float R[9]) {
    float d = det9(R);
    if (!(d > 0.0 && abs(d-1.0) <= 1e-2)) return false;
    float e = 0;
    for (int i = 0; i < 3; i++) for (int j = 0; j < 3; j++) { float v = R[i]*R[j]+R[3+i]*R[3+j]+R[6+i]*R[6+j]-((i==j)?1.0:0.0); e = max(e,abs(v)); }
    return e <= 1e-2;
}
void jacobi9(float Ain[9], out float w[3], out float V[9]) {
    float A[9]; for (int i = 0; i < 9; i++) A[i] = Ain[i];
    for (int i = 0; i < 9; i++) V[i] = (i%4==0)?1.0:0.0;
    int pp[3]; pp[0]=0; pp[1]=0; pp[2]=1; int qq[3]; qq[0]=1; qq[1]=2; qq[2]=2;
    for (int sweep = 0; sweep < 50; sweep++) {
        if (abs(A[1])+abs(A[2])+abs(A[5]) < 1e-20) break;
        for (int k = 0; k < 3; k++) {
            int p = pp[k], q = qq[k]; float apq = A[p*3+q];
            if (abs(apq) < 1e-20) continue;
            float phi = 0.5*atan2(2.0*apq, A[q*3+q]-A[p*3+p]); float c = cos(phi), s = sin(phi);
            for (int i = 0; i < 3; i++) { float aip=A[i*3+p], aiq=A[i*3+q]; A[i*3+p]=c*aip-s*aiq; A[i*3+q]=s*aip+c*aiq; }
            for (int i = 0; i < 3; i++) { float api=A[p*3+i], aqi=A[q*3+i]; A[p*3+i]=c*api-s*aqi; A[q*3+i]=s*api+c*aqi; }
            for (int i = 0; i < 3; i++) { float vip=V[i*3+p], viq=V[i*3+q]; V[i*3+p]=c*vip-s*viq; V[i*3+q]=s*vip+c*viq; }
        }
    }
    w[0]=A[0]; w[1]=A[4]; w[2]=A[8];
}
void kabsch(float H[9], out float R[9]) {
    float S[9]; for (int i = 0; i < 3; i++) for (int j = 0; j < 3; j++) S[i*3+j] = H[i]*H[j]+H[3+i]*H[3+j]+H[6+i]*H[6+j];
    float w[3]; float Vc[9]; jacobi9(S,w,Vc);
    int ord[3]; ord[0]=0; ord[1]=1; ord[2]=2;
    for (int a = 0; a < 3; a++) for (int b = a+1; b < 3; b++) if (w[ord[b]] > w[ord[a]]) { int t=ord[a]; ord[a]=ord[b]; ord[b]=t; }
    float V[9]; float sig[3];
    for (int c = 0; c < 3; c++) { sig[c] = sqrt(max(w[ord[c]],0.0)); for (int r = 0; r < 3; r++) V[r*3+c] = Vc[r*3+ord[c]]; }
    float U[9];
    for (int c = 0; c < 3; c++) {
        float3 hv = float3(H[0]*V[c]+H[1]*V[3+c]+H[2]*V[6+c], H[3]*V[c]+H[4]*V[3+c]+H[5]*V[6+c], H[6]*V[c]+H[7]*V[3+c]+H[8]*V[6+c]);
        float sc = sig[c] > 1e-12 ? 1.0/sig[c] : 0.0; U[c]=hv.x*sc; U[3+c]=hv.y*sc; U[6+c]=hv.z*sc;
    }
    for (int c = 0; c < 3; c++) if (sig[c] <= 1e-12) {
        int a = (c+1)%3, b = (c+2)%3; float3 ua = float3(U[a],U[3+a],U[6+a]), ub = float3(U[b],U[3+b],U[6+b]);
        float3 uc = cr(ua,ub); U[c]=uc.x; U[3+c]=uc.y; U[6+c]=uc.z;
    }
    float Vt[9]; for (int i = 0; i < 3; i++) for (int j = 0; j < 3; j++) Vt[i*3+j] = V[j*3+i];
    float UVt[9]; mul9(U,Vt,UVt); float sgn = det9(UVt) < 0 ? -1.0 : 1.0;
    float Ud[9]; for (int i = 0; i < 9; i++) Ud[i] = U[i]; Ud[2]*=sgn; Ud[5]*=sgn; Ud[8]*=sgn;
    mul9(Ud,Vt,R);
}
void finishAlign(float Hin[9], int N, float3 a0, float3 a1, float3 b0, float3 b1, out float R[9]) {
    if (N == 1) { rodrigues(a0,b0,R); return; }
    float H[9]; for (int i = 0; i < 9; i++) H[i] = Hin[i];
    float3 ns = cr(a0,a1), nd = cr(b0,b1); float ln = length(ns), ld = length(nd);
    if (ln > 1e-9 && ld > 1e-9) {
        float vsa[3]; float3 vs = ns*(length(a0)/(ln+EPS)); vsa[0]=vs.x; vsa[1]=vs.y; vsa[2]=vs.z;
        float vda[3]; float3 vd = nd*(length(b0)/(ld+EPS)); vda[0]=vd.x; vda[1]=vd.y; vda[2]=vd.z;
        for (int i = 0; i < 3; i++) for (int j = 0; j < 3; j++) H[i*3+j] += vsa[i]*vda[j];
    }
    regularize(H); ns30(H,R); if (!valid9(R)) kabsch(H,R);
}

[shader("compute")]
[numthreads(1, 1, 1)]
void skeleton_fit(uint3 tid : SV_DispatchThreadID)
{
    if (tid.x != 0) return;
    uint J, st; parents.GetDimensions(J, st);
    uint Vc, st2; v0.GetDimensions(Vc, st2); uint V = Vc/3;
    for (uint j = 0; j < J; j++) for (int k = 0; k < 9; k++) { int r=k/3, c=k%3; outbw[j*16+r*4+c] = bw[j*16+r*4+c]; }
