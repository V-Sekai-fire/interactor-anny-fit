            if (sw[v*J+i] <= 0.01) continue;
            float3 tg = float3(v0[v*3]-jpi.x, v0[v*3+1]-jpi.y, v0[v*3+2]-jpi.z);
            float3 og = float3(bsh[v*3]-bpx, bsh[v*3+1]-bpy, bsh[v*3+2]-bpz);
            float ta[3]={tg.x,tg.y,tg.z}; float oa[3]={og.x,og.y,og.z};
            for (int a = 0; a < 3; a++) for (int b = 0; b < 3; b++) Hs[a*3+b] += ta[a]*oa[b];
            if (cnt == 0) { sa0=tg; sb0=og; } else if (cnt == 1) { sa1=tg; sb1=og; } cnt++;
        }
        float Rinit[9]; finishAlign(Hs, cnt, sa0, sa1, sb0, sb1, Rinit);
        float Hc[9]; for (int k = 0; k < 9; k++) Hc[k] = 0;
