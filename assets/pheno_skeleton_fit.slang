            float3 pco = float3(Rinit[0]*wv.x+Rinit[1]*wv.y+Rinit[2]*wv.z, Rinit[3]*wv.x+Rinit[4]*wv.y+Rinit[5]*wv.z, Rinit[6]*wv.x+Rinit[7]*wv.y+Rinit[8]*wv.z);
            float3 pcn = float3(jpos[cj*3]-jpi.x, jpos[cj*3+1]-jpi.y, jpos[cj*3+2]-jpi.z);
            float na[3]={pcn.x,pcn.y,pcn.z}; float oa[3]={pco.x,pco.y,pco.z};
            for (int a = 0; a < 3; a++) for (int b = 0; b < 3; b++) Hc[a*3+b] += na[a]*oa[b];
            if (c == 0) { ca0=pcn; cb0=pco; } else if (c == 1) { ca1=pcn; cb1=pco; }
        }
        float Arot[9]; finishAlign(Hc, nc, ca0, ca1, cb0, cb1, Arot);
        float R0[9]; for (int k = 0; k < 9; k++) { int r=k/3,c=k%3; R0[k] = outbw[i*16+r*4+c]; }
        float tmp[9]; mul9(Arot, Rinit, tmp); float Ri[9]; mul9(tmp, R0, Ri);
        for (int k = 0; k < 9; k++) { int r=k/3,c=k%3; outbw[i*16+r*4+c] = Ri[k]; }
    }
    for (uint j = 0; j < J; j++) {
        outbw[j*16+3] = jpos[j*3]; outbw[j*16+7] = jpos[j*3+1]; outbw[j*16+11] = jpos[j*3+2];
        outbw[j*16+12]=0; outbw[j*16+13]=0; outbw[j*16+14]=0; outbw[j*16+15]=1;
    }
}
