// Phenotype → shape, data-parallel stages.  Matches viz_native/soma_pheno.c.

[[vk::binding(0, 0)]] StructuredBuffer<float3> vanny;  // (P)     Anny verts
[[vk::binding(1, 0)]] StructuredBuffer<uint>   Fsrc;   // (NFS*3) source tri indices
[[vk::binding(2, 0)]] RWStructuredBuffer<float3> p3;   // (NFS)   output tip

[shader("compute")]
[numthreads(64, 1, 1)]
void bary_tet(uint3 tid : SV_DispatchThreadID)
{
    uint f = tid.x;
    uint NFS, s; p3.GetDimensions(NFS, s);
    if (f >= NFS) return;
    float3 a = vanny[Fsrc[f * 3 + 0]];
